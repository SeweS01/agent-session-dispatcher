[Unit]
Description=Agent Session Dispatcher Telegram Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/agent-session-dispatcher/dispatcher.env
ExecStart=%h/.local/bin/agent-session-dispatcher run
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
# PrivateTmp is intentionally disabled: tmux/Codex discovery must inspect the
# existing user's process tree and open rollout file descriptors.

[Install]
WantedBy=default.target
